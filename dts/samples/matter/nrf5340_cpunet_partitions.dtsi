/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;

&flash1 {
	partitions {
		b0n_partition: partition@1000000 {
			label = "b0n";
			reg = <0x1000000 0x8580>;
		};

		bl_storage: provision_partition: partition@1008580 {
			label = "b0-provision-data";
			reg = <0x1008580 0x280>;
		};

		s0_partition: partition@1008800 {
			label = "image-0";
			reg = <0x1008800 DT_SIZE_K(220)>;
		};
	};
};
